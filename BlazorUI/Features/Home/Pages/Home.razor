@page "/"
@inject IMessageService Queue

<PageTitle>Home - BlazorUI</PageTitle>

<h1>Service Bus Demo</h1>

<section class="my-3">
    <div class="d-flex">
        <div class="card shadow">
            <div class="card-header">
                <h5 class="mb-0">Create Person</h5>
            </div>
            <div class="card-body">
                <EditForm Enhance id="personForm" FormName="personForm" Model="@Person" OnValidSubmit="PushMessage">
                    <DataAnnotationsValidator />
                    <BSInputText Id="firstName" @bind-Value="Person!.FirstName" Label="First Name" />
                    <BSInputText Id="lastName" Class="my-2" @bind-Value="Person.LastName" Label="Last Name" />
                    <button class="btn btn-primary" type="submit">Submit</button>
                </EditForm>
            </div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromForm(FormName = "personForm")]
    public PersonModel? Person { get; set; }

    protected override void OnInitialized()
    {
        Person ??= new();
    }

    private async Task PushMessage()
    {
        await Queue.SendMessageToQueueAsync(Person, "personqueue");
        await Queue.SendMessageToTopicAsync(Person, "personTopic");
        Person = new();
    }
}