[
  {
    "Name": "BlazorUI + Console",
    "Projects": [
      {
        "Path": "ConsoleUI\\ConsoleUI.csproj",
        "Action": "Start",
        "DebugTarget": "ConsoleUI"
      },
      {
        "Path": "BlazorUI\\BlazorUI.csproj",
        "Action": "StartWithoutDebugging",
        "DebugTarget": "https"
      }
    ]
  },
  {
    "Name": "BlazorUI + Function",
    "Projects": [
      {
        "Path": "FunctionApp\\FunctionApp.csproj",
        "Action": "Start",
        "DebugTarget": "FunctionApp"
      },
      {
        "Path": "BlazorUI\\BlazorUI.csproj",
        "Action": "Start",
        "DebugTarget": "https"
      }
    ]
  }
]